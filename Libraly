local function getLabelObject(Id)
    return (Library.Options and Library.Options[Id]) or (Library.Labels and Library.Labels[Id])
end

local function setLabelText(Id, Text)
    local Label = getLabelObject(Id)
    if Label and type(Label.SetText) == "function" then
        pcall(function()
            Label:SetText(tostring(Text or ""))
        end)
    end
end

local function previewText(Text, Limit)
    Text = tostring(Text or "")
    Limit = Limit or 1100
    if #Text > Limit then
        return Text:sub(1, Limit) .. "\n\n… preview truncated; full content remains in memory/file."
    end
    if Text == "" then
        return "— empty —"
    end
    return Text
end

local function appendLog(Message)
    local Clock = os.date("%H:%M:%S")
    table.insert(State.Logs, "[" .. Clock .. "] " .. tostring(Message))
    while #State.Logs > 8 do
        table.remove(State.Logs, 1)
    end
    setLabelText("ActivityLog", table.concat(State.Logs, "\n"))
end

local function countEnabledMethodOptions()
    local Count = 0
    for _, Id in ipairs(CountedMethodIds) do
        if State.Options[Id] then
            Count = Count + 1
        end
    end
    return Count
end

local function hasAnyStringTransform()
    return State.Options.XorStrings
        or State.Options.Base64Strings
        or State.Options.CharCodeStrings
        or State.Options.ArithmeticStrings
        or State.Options.SplitStrings
        or State.Options.ReverseStrings
        or State.Options.ROT13Strings
        or State.Options.HexStrings
end

local function computeProtectionLevel()
    local Score = 0
    local MaxScore = 0
    local Items = {
        { hasAnyStringTransform(), 8 },
        { State.Options.RenameVariables, 6 },
        { State.Options.EncodeNumbersAdd or State.Options.EncodeNumbersMul or State.Options.EncodeNumbersSub, 6 },
        { State.Options.ConstantArray, 8 },
        { State.Options.BooleanExpressions, 4 },
        { State.Options.JunkCode, 4 },
        { State.Options.OpaquePredicates, 4 },
        { State.Options.FalseBranches, 3 },
        { State.Options.DummyFunctions, 3 },
        { State.Options.VarargRewrite, 4 },
        { State.Options.AntiTamper, 12 },
        { State.Options.MainVM, 30 },
        { State.Options.AntiDebug, 4 },
        { State.Options.AntiHook, 4 },
        { State.Options.AntiDumper, 4 },
        { State.Options.BreakMemory, 6 },
    }
    for _, Item in ipairs(Items) do
        MaxScore = MaxScore + Item[2]
        if Item[1] then
            Score = Score + Item[2]
        end
    end
    if MaxScore == 0 then
        return 0
    end
    return math.floor((Score * 100) / MaxScore)
end

local function updateMetrics()
    local Level = computeProtectionLevel()
    local Count = countEnabledMethodOptions()
    setLabelText("ProtectionMetric", tostring(Level) .. "%")
    setLabelText("MethodMetric", tostring(Count))
    setLabelText("InputMetric", tostring(#(State.SourceCode or "")) .. " bytes (UTF-8 approximation)")
    setLabelText("OutputMetric", tostring(#(State.OutputCode or "")) .. " bytes")
    setLabelText("CompareProtection", tostring(Level) .. "%")
    setLabelText("CompareMethods", tostring(Count))
    setLabelText("ProfileMethods", tostring(Count))
    setLabelText("ProfileProtection", tostring(Level) .. "%")
end


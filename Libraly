local SettingsAppearance = Tabs.Settings:AddRightGroupbox("THEME & APPEARANCE", "palette")
local function applyTheme(ThemeName)
    State.Theme = ThemeName
    if ThemeName == "Light" then
        Library.Scheme.BackgroundColor = Color3FromRGB(245, 247, 252)
        Library.Scheme.MainColor = Color3FromRGB(255, 255, 255)
        Library.Scheme.FontColor = Color3FromRGB(24, 31, 52)
        Library.Scheme.OutlineColor = Color3FromRGB(211, 220, 242)
        Library.Scheme.DarkColor = Color3FromRGB(235, 239, 249)
    else
        Library.Scheme.BackgroundColor = Color3FromRGB(4, 9, 22)
        Library.Scheme.MainColor = Color3FromRGB(7, 15, 32)
        Library.Scheme.FontColor = Color3FromRGB(220, 230, 255)
        Library.Scheme.OutlineColor = Color3FromRGB(24, 70, 125)
        Library.Scheme.DarkColor = Color3FromRGB(5, 12, 27)
    end
    if Library.UpdateColorsUsingRegistry then
        pcall(function() Library:UpdateColorsUsingRegistry() end)
    end
    appendLog("Theme selected: " .. ThemeName .. ".")
end


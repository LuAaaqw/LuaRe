local function syncOutputPreview(Message)
    local Text = State.OutputCode
    if Text == "" and Message then
        Text = Message
    end
    if OutputEditor then
        OutputEditorUpdating = true
        if #Text > MaxEditorChars then
            OutputEditor.Text = Text:sub(1, MaxEditorChars)
            setLabelText("OutputStatus", "Showing first " .. tostring(MaxEditorChars) .. " characters; full output remains in memory.")
        else
            OutputEditor.Text = Text
            setLabelText("OutputStatus", tostring(#(State.OutputCode or "")) .. " output bytes")
        end
        OutputEditorUpdating = false
    else
        setLabelText("OutputPreview", previewText(Text, 1300))
    end
    updateMetrics()
end

local function getInputValue(Id, Fallback)
    local Item = Library.Options and Library.Options[Id]
    if Item and Item.Value ~= nil then
        return Item.Value
    end
    return Fallback
end

local function executorFunction(Name)
    local Value = nil
    pcall(function()
        if type(getgenv) == "function" then
            local Environment = getgenv()
            if type(Environment) == "table" then
                Value = Environment[Name]
            end
        end
    end)
    if type(Value) == "function" then
        return Value
    end

    pcall(function()
        if type(getfenv) == "function" then
            local Environment = getfenv(0)
            if type(Environment) == "table" then
                Value = Environment[Name]
            end
        end
    end)
    if type(Value) == "function" then
        return Value
    end

    pcall(function()
        Value = _G[Name]
    end)
    if type(Value) == "function" then
        return Value
    end
    return nil
end


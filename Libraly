end

local function loadSourceFile(IsDeobfuscation)
    local IsFile = executorFunction("isfile")
    local ReadFile = executorFunction("readfile")
    local Path = getSourcePath()
    if IsDeobfuscation then
        local Value = getInputValue("DeobfSourcePath", State.DeobfSourcePath)
        if type(Value) == "string" and Value ~= "" then
            State.DeobfSourcePath = Value
        end
        Path = State.DeobfSourcePath
    end
    if not IsFile or not ReadFile then
        appendLog("File loading unavailable: this executor does not expose isfile/readfile.")
        notify("File API unavailable", "Paste or type source directly into the multiline source editor.", 5)
        return
    end
    local ExistsOk, Exists = pcall(IsFile, Path)
    if not ExistsOk or not Exists then
        appendLog("Source file not found: " .. Path)
        notify("Source file not found", Path, 4)
        return
    end
    local ReadOk, Data = pcall(ReadFile, Path)
    if not ReadOk or type(Data) ~= "string" then
        appendLog("Could not read source file: " .. Path)
        notify("Read failed", Path, 4)
        return
    end
    if IsDeobfuscation then
        State.DeobfSourceCode = Data
        State.DeobfSourceLoadedFromFile = true
        if DeobfEditor then
            DeobfEditorUpdating = true
            DeobfEditor.Text = Data:sub(1, MaxEditorChars)
            DeobfEditorUpdating = false
        end
    else
        State.SourceCode = Data
        State.SourceLoadedFromFile = true
        State.LastInputBytes = #Data
        if SourceEditor then
            SourceEditorUpdating = true
            SourceEditor.Text = Data:sub(1, MaxEditorChars)
            SourceEditorUpdating = false
        end
    end
    syncSourcePreview()
    appendLog("Loaded " .. Path .. " (" .. tostring(#Data) .. " bytes).")
    notify("Source loaded", tostring(#Data) .. " bytes are now stored in memory. The preview is truncated when long.", 4)
end

local function saveOutputFile()
    local WriteFile = executorFunction("writefile")
    local Path = getOutputPath()
    if State.OutputCode == "" then
        appendLog("Save cancelled: no output exists. The native C++ engine is not included in this UI port.")
        notify("Nothing to save", "Run requires the separate Lua-Re obfuscation backend.", 5)
        return
    end
    if not WriteFile then
        appendLog("File saving unavailable: this executor does not expose writefile.")
        notify("File API unavailable", "This executor does not expose writefile.", 4)
        return
    end
    local Ok, Err = pcall(WriteFile, Path, State.OutputCode)
    if not Ok then
        appendLog("Save failed: " .. tostring(Err))
        notify("Save failed", tostring(Err), 5)
        return
    end
    appendLog("Saved output to " .. Path .. ".")
    notify("Output saved", Path, 4)
end

local function copyOutput()
    if State.OutputCode == "" then
        notify("Nothing to copy", "No output is available yet.", 3)
        return
    end
    local SetClipboard = executorFunction("setclipboard") or executorFunction("toclipboard")
    if not SetClipboard then
        appendLog("Clipboard unavailable: executor does not expose a clipboard function.")
        notify("Clipboard unavailable", "This executor does not expose setclipboard.", 4)
        return
    end
    local Ok, Err = pcall(SetClipboard, State.OutputCode)
    if Ok then
        appendLog("Output copied to clipboard.")
        notify("Copied", "Output copied to clipboard.", 3)
    else
        appendLog("Clipboard copy failed: " .. tostring(Err))
        notify("Copy failed", tostring(Err), 4)
    end
end

local function checkVmConflicts()
    if not State.Options.MainVM then
        return nil
    end
    local ConflictingIds = {
        "XorStrings", "CharCodeStrings", "ArithmeticStrings", "SplitStrings", "Base64Strings",
        "RenameVariables", "VarargRewrite", "ConstantArray", "EncodeNumbersAdd", "EncodeNumbersMul",
        "EncodeNumbersSub", "BooleanExpressions", "ReverseStrings", "ROT13Strings", "HexStrings",
    }
    local ConflictingNames = {
        XorStrings = "XOR Strings", CharCodeStrings = "CharCode Strings",
        ArithmeticStrings = "Arithmetic Strings", SplitStrings = "Split Strings",
        Base64Strings = "Base64 Strings", RenameVariables = "Rename Variables",
        VarargRewrite = "Vararg Rewrite", ConstantArray = "Constant Array",
        EncodeNumbersAdd = "Add / Sub Numbers", EncodeNumbersMul = "Multiply Numbers",
        EncodeNumbersSub = "Subtract Numbers", BooleanExpressions = "Boolean Expressions",
        ReverseStrings = "Reverse Strings", ROT13Strings = "ROT13 Strings", HexStrings = "HEX Strings",
    }
    local Conflicts = {}
    for _, Id in ipairs(ConflictingIds) do
        if State.Options[Id] then
            table.insert(Conflicts, ConflictingNames[Id] or Id)
        end
    end
    if #Conflicts > 0 then
        return "Main VM conflicts with: " .. table.concat(Conflicts, ", ")
    end
    return nil
end

local function runObfuscation()
    if SourceEditor and not State.SourceLoadedFromFile then
        State.SourceCode = SourceEditor.Text
    end
    if State.SourceCode == "" then
        appendLog("Obfuscation stopped: source code is empty.")
        syncOutputPreview("No output generated: source is empty.")
        notify("Empty source", "Enter Lua code or load a .lua file first.", 4)
        return
    end
    local Conflict = checkVmConflicts()
    if Conflict then
        State.OutputCode = ""
        syncOutputPreview("No output generated because selected options conflict.")
        appendLog("[!] " .. Conflict)
        notify("Option conflict", Conflict, 6)
        return
    end
    State.OutputCode = ""
    State.LastRunSucceeded = false
    State.LastInputBytes = #State.SourceCode
    syncOutputPreview("No output generated. LuaObfuscator::Obfuscate is part of the separate C++ backend and has not been ported into this file.")
    appendLog("Obfuscation requested with " .. tostring(countEnabledMethodOptions()) .. " selected methods and preset '" .. tostring(State.Preset) .. "'.")
    appendLog("[!] UI-only port: LuaObfuscator::Obfuscate is not available in the supplied main.cpp alone.")
    notify("Backend not included", "The interface and option state are ported. The native obfuscator engine must be ported separately to produce output.", 7)
end

local function runDeobfuscation()
    if DeobfEditor and not State.DeobfSourceLoadedFromFile then
        State.DeobfSourceCode = DeobfEditor.Text
    end
    if State.DeobfSourceCode == "" then
        appendLog("Deobfuscation stopped: source code is empty.")
        notify("Empty source", "Enter or load an obfuscated Lua file first.", 4)
        return
    end
    State.OutputCode = ""
    State.LastRunSucceeded = false
    syncOutputPreview("No output generated. LuaDeobfuscator::Deobfuscate is part of the separate C++ backend and has not been ported into this file.")
    appendLog("Deobfuscation requested with " .. tostring(#DeobfOptionIds) .. " enabled recognizers.")
    appendLog("[!] UI-only port: LuaDeobfuscator::Deobfuscate is not available in the supplied main.cpp alone.")
    notify("Backend not included", "The GUI is ready; the native deobfuscator engine is a separate C++ module.", 7)
end


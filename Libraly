    State.DeobfSourceLoadedFromFile = false
    if OutputEditor then
        OutputEditorUpdating = true
        OutputEditor.Text = ""
        OutputEditorUpdating = false
    end
    State.LastInputBytes = 0
    State.LastOutputBytes = 0
    if SourceEditor then
        SourceEditorUpdating = true
        SourceEditor.Text = ""
        SourceEditorUpdating = false
    end
    if DeobfEditor then
        DeobfEditorUpdating = true
        DeobfEditor.Text = ""
        DeobfEditorUpdating = false
    end
    syncSourcePreview()
    syncOutputPreview()
    appendLog("Workspace cleared.")
end


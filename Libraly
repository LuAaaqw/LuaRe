SettingsGeneral:AddDropdown("PresetSelect", {
    Text = "Preset",
    Values = { "Custom", "Light", "Medium", "Strong", "Paranoid", "VM Only", "Anti-Tamper", "Max" },
    Default = "Custom",
    Multi = false,
    Callback = function(Value)
        if type(Value) == "table" then
            Value = Value[1]
        end
        if type(Value) == "string" then
            State.Preset = Value
            appendLog("Preset selected: " .. Value .. ".")
            if Value ~= "Custom" then
                local Profiles = {
                    Light = { XorStrings = true, RenameVariables = true, RemoveComments = true, SplitStrings = true },
                    Medium = { XorStrings = true, Base64Strings = true, RenameVariables = true, RemoveComments = true, EncodeNumbersAdd = true, ReverseStrings = true },
                    Strong = { XorStrings = true, CharCodeStrings = true, SplitStrings = true, RenameVariables = true, RemoveComments = true, EncodeNumbersAdd = true, EncodeNumbersMul = true, ConstantArray = true, AntiTamper = true, JunkCode = true, OpaquePredicates = true },
                    Paranoid = { XorStrings = true, CharCodeStrings = true, SplitStrings = true, ReverseStrings = true, ROT13Strings = true, HexStrings = true, RenameVariables = true, RemoveComments = true, EncodeNumbersAdd = true, EncodeNumbersMul = true, EncodeNumbersSub = true, ConstantArray = true, AntiTamper = true, AntiDebug = true, AntiHook = true, AntiDumper = true, JunkCode = true, OpaquePredicates = true, FalseBranches = true, DummyFunctions = true, BreakMemory = true },
                    ["VM Only"] = { MainVM = true, VM2RuntimeVM = true },
                    ["Anti-Tamper"] = { AntiTamper = true, RemoveComments = true },
                    Max = { MainVM = true, VM2RuntimeVM = true, AntiTamper = true, AntiDebug = true, AntiHook = true, AntiDumper = true, BreakMemory = true, RuntimeStaticHardening = true, LLSStringRuntime = true, RemoveComments = true },
                }
                local Selected = Profiles[Value]
                if Selected then
                    for _, Id in ipairs(MethodOptionIds) do
                        local Handle = Library.Toggles and Library.Toggles[Id]
                        local Enabled = Selected[Id] == true
                        State.Options[Id] = Enabled
                        if Handle and Handle.SetValue then
                            pcall(function() Handle:SetValue(Enabled) end)
                        end
                    end
                    for Id, _ in pairs(ToggleDefaults) do
                        if not table.find(MethodOptionIds, Id) then
                            local Handle = Library.Toggles and Library.Toggles[Id]
                            local Enabled = Selected[Id] == true
                            State.Options[Id] = Enabled
                            if Handle and Handle.SetValue then
                                pcall(function() Handle:SetValue(Enabled) end)
                            end
                        end
                    end
                end
                updateMetrics()
                local Conflict = checkVmConflicts()
                if Conflict then
                    setLabelText("ConflictStatus", "[!] " .. Conflict)
                else
                    setLabelText("ConflictStatus", "[OK] No Main VM option conflicts detected.")
                end
            end
        end
    end,
})
